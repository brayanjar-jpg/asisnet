        for t in datos_lista:
            ruta_pdf_local = t["ruta_archivo_pdf"]
            print(f"      [LECTOR-PDF] Abriendo y parseando: D:\\sunat_tregistro\\{os.path.basename(ruta_pdf_local)}")
            
            info_profunda = extraer_datos_profundos_pdf(ruta_pdf_local)
            
            datos_maestro = {
                "dni": t["dni"],
                "nombres_completos": t["nombres_completos"],
                "fecha_nacimiento": info_profunda["fecha_nacimiento"], 
                "sexo": info_profunda["sexo"],
                "celular": info_profunda["celular"],
                "email": info_profunda["email"],
                "direccion": info_profunda["direccion"]
            }
            supabase.table("trabajadores_maestro").upsert(datos_maestro).execute()
            
            datos_laboral = {
