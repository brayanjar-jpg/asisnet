                "dni": t["dni"],
                "categoria_ocupacional": info_profunda["categoria_ocupacional"],
                "ocupacion_cargo": info_profunda["ocupacion_cargo"],
                "tipo_contrato": info_profunda["tipo_contrato"],
                "fecha_inicio_labores": info_profunda["fecha_inicio_labores"], 
                "fecha_fin_labores": None,
                "estado_sunat": t["estado_sunat"],
                "ruta_archivo_pdf": t["ruta_archivo_pdf"]
            }
            supabase.table("trabajadores_laboral").upsert(datos_laboral).execute()
            
            if info_profunda["regimen_salud"] and info_profunda["fecha_inicio_salud"]:
                datos_salud = {
                    "dni": t["dni"],
                    "regimen_salud": info_profunda["regimen_salud"],
                    "fecha_inicio": info_profunda["fecha_inicio_salud"],
                    "fecha_fin": None,
                    "entidad_prestadora": info_profunda["entidad_prestadora"]
                }
                supabase.table("trabajadores_salud").upsert(datos_salud).execute()
                
            if info_profunda["regimen_pensionario"] and info_profunda["fecha_inicio_pension"]:
                datos_pension = {
                    "dni": t["dni"],
                    "regimen_pensionario": info_profunda["regimen_pensionario"],
                    "fecha_inicio": info_profunda["fecha_inicio_pension"],
                    "fecha_fin": None,
                    "cuspp": info_profunda["cuspp"]
                }
                supabase.table("trabajadores_pension").upsert(datos_pension).execute()
            
        print("   [SUPABASE] Éxito absoluto: Las 4 tablas relacionales históricas fueron sincronizadas.")
    except Exception as e:
        print(f"   [ERROR-NUBE] Error crítico en el procesamiento relacional profundo: {e}")


