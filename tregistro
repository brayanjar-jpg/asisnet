# PARTE 3: ORQUESTRADOR CENTRAL (run)
# =====================================================================
async def run():
    print("[SISTEMA] Iniciando Orquestador Multicliente de T-Registro...")
    try:
        res = supabase.table("empresas").select("*").eq("activo", True).execute()
        lista_empresas = res.data
        print(f"[SUPABASE] Encontradas {len(lista_empresas)} empresas marcadas con check [v].")
    except Exception as e:
        print(f"[ERROR-DB] No se cargó la lista de empresas: {e}")
        return

    async with async_playwright() as p:
        browser = await p.chromium.launch(headless=False, args=["--start-maximized", "--disable-blink-features=AutomationControlled"])
        for empresa in lista_empresas:
            ruc = empresa.get("ruc")
            usuario = empresa.get("usuario_sol")
            clave = empresa.get("clave_sol")
            if ruc and usuario and clave:
                trabajadores = await procesar_tregistro_empresa(ruc, usuario, clave, browser)
                if trabajadores:
                    await guardar_trabajadores_supabase(trabajadores)
            await asyncio.sleep(2)
        await browser.close()


