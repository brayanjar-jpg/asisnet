def extraer_datos_profundos_pdf(ruta_pdf):
    datos = {
        "fecha_nacimiento": None, "sexo": None, "celular": None, "email": None, "direccion": None,
        "categoria_ocupacional": None, "ocupacion_cargo": None, "tipo_contrato": None, "fecha_inicio_labores": None,
        "regimen_salud": None, "fecha_inicio_salud": None, "entidad_prestadora": None,
        "regimen_pensionario": None, "fecha_inicio_pension": None, "cuspp": None
    }
    
    if not os.path.exists(ruta_pdf):
        print(f"      [ALERTA-PDF] El archivo no existe físicamente: {ruta_pdf}")
        return datos

    try:
        with pdfplumber.open(ruta_pdf) as pdf:
            texto_completo = ""
            for pagina in pdf.pages:
                texto_pag = pagina.extract_text()
                if texto_pag:
                    texto_completo += texto_pag + "\n"
            
            lineas = [l.strip() for l in texto_completo.split("\n") if l.strip()]
            texto_limpio = "\n".join(lineas)
            
            match_nac = re.search(r"Fecha de Nacimiento:\s*([\d/]+)", texto_limpio, re.IGNORECASE)
            if match_nac: datos["fecha_nacimiento"] = match_nac.group(1)
            
            match_sexo = re.search(r"Sexo:\s*([A-Za-z]+)", texto_limpio, re.IGNORECASE)
            if match_sexo: datos["sexo"] = match_sexo.group(1)
            
            match_cel = re.search(r"Teléfono:\s*([\d\-]+)", texto_limpio, re.IGNORECASE)
            if match_cel: datos["celular"] = match_cel.group(1)
            
            match_mail = re.search(r"Correo Electrónico:\s*([^\s@]+@[^\s@]+\.[^\s@]+)", texto_limpio, re.IGNORECASE)
            if match_mail: datos["email"] = match_mail.group(1)

            match_cat = re.search(r"Categoría Ocupacional:\s*(.+)", texto_limpio, re.IGNORECASE)
            if match_cat: datos["categoria_ocupacional"] = match_cat.group(1).strip()
            
            match_ocu = re.search(r"Ocupación/Cargo:\s*(.+)", texto_limpio, re.IGNORECASE)
            if match_ocu: datos["ocupacion_cargo"] = match_ocu.group(1).strip()
            
            match_cont = re.search(r"Tipo de Contrato:\s*(.+)", texto_limpio, re.IGNORECASE)
            if match_cont: datos["tipo_contrato"] = match_cont.group(1).strip()

            if "ESSALUD REGULAR" in texto_limpio:
                datos["regimen_salud"] = "ESSALUD REGULAR"
                match_f_salud = re.search(r"ESSALUD REGULAR\s+([\d/]+)", texto_limpio)
                if match_f_salud: datos["fecha_inicio_salud"] = match_f_salud.group(1)

            match_pen = re.search(r"(SPP\s+[A-Za-z]+|ONP)", texto_limpio, re.IGNORECASE)
            if match_pen:
                datos["regimen_pensionario"] = match_pen.group(1).strip()
                match_datos_pen = re.search(r"(?:SPP\s+[A-Za-z]+|ONP)\s+([\d/]+)\s+(?:-|\s+)\s*([A-Z0-9]+)?", texto_limpio, re.IGNORECASE)
                if match_datos_pen:
                    datos["fecha_inicio_pension"] = match_datos_pen.group(1)
                    if match_datos_pen.group(2):
                        datos["cuspp"] = match_datos_pen.group(2)
            
            datos["fecha_inicio_labores"] = datos["fecha_inicio_pension"] or datos["fecha_inicio_salud"] or datetime.now().strftime("%d/%m/%Y")
            
        return datos
    except Exception as e_pdf:
        print(f"      [ALERTA-PDF] Error procesando texto con pdfplumber: {e_pdf}")
        return datos


