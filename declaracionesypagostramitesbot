async def procesar_consulta_declaraciones(ruc, usuario, clave, browser,
                                           fecha_ini="01/01/2026", fecha_fin="01/01/2026"):
    print(f"\n [IA-CONSULTA] Iniciando consulta de declaraciones para RUC: {ruc}")
    context = await browser.new_context(accept_downloads=True)
    page = await context.new_page()

    try:
        # 1) LOGIN
        print(" [SOL-LOGIN] Abriendo formulario SUNAT...")
        await page.goto(URL_LOGIN_SUNAT, timeout=45000)
        await page.wait_for_timeout(2000)
        await page.click("#btnPorRuc")
        await page.wait_for_timeout(500)
        await page.fill("#txtRuc", ruc)
        await page.fill("#txtUsuario", usuario)
        await page.fill("#txtContrasena", clave)
        print(" [SOL-LOGIN] Enviando credenciales...")
        await page.click("#btnAceptar")
        await page.wait_for_timeout(5000)

        # 2) PRIMER SALTO: módulo de Consulta de declaraciones y pagos
        url_menu = "https://e-menu.sunat.gob.pe/cl-ti-itmenu/MenuInternet.htm?action=execute&code=12.8.1.1.2&s=ww1"
        print(" [SALTO-1] Ejecutando salto directo al módulo de consulta...")
        await page.goto(url_menu, timeout=45000)
        await page.wait_for_timeout(3000)

        # 3) SEGUNDO SALTO: consulta general con filtros de fecha
        fec_ini_enc = urllib.parse.quote(fecha_ini, safe="")
        fec_fin_enc = urllib.parse.quote(fecha_fin, safe="")
        url_detalle = (
            "https://ww1.sunat.gob.pe/cl-ti-itconsdecdetinf/consultaS01Alias"
            "?busquedapor=fecha&accion=consultageneral&declaracion=1&formu2=TODOS"
            "&importepagado=1&mdesde=00&adesde=00&mhasta=00&ahasta=00"
            f"&fec_preini={fec_ini_enc}&fec_prefin={fec_fin_enc}"
        )
        print(" [SALTO-2] Solicitando el detalle de declaraciones...")
        await page.goto(url_detalle, timeout=45000)
        await page.wait_for_timeout(4000)

        # 4) GRILLA PRINCIPAL -> declaraciones_pagos
        registros = await extraer_declaraciones_pagos(page)
        await guardar_declaraciones_supabase(ruc, registros)

        # Respaldo CSV de la grilla principal
        if registros:
            ruta_csv = os.path.join(CARPETA_SALIDA, f"declaraciones_{ruc}.csv")
            with open(ruta_csv, "w", newline="", encoding="utf-8-sig") as f:
                writer = csv.DictWriter(f, fieldnames=registros[0].keys())
                writer.writeheader()
                writer.writerows(registros)
            print(f" [CSV] Guardado: {ruta_csv}")

        # 5) DETALLE DE PAGO POR ORDEN -> detalle_tributos_pagos
        print(f" [DETALLE] Procesando el detalle de {len(registros)} órdenes...")
        for i, registro in enumerate(registros):
            es_la_primera = (i == 0)  # guardamos un HTML de referencia solo de la primera
            detalle = await procesar_detalle_pago(page, ruc, registro, guardar_diagnostico=es_la_primera)
            await guardar_detalle_tributos_supabase(registro["num_orden"], detalle)
            await page.wait_for_timeout(700)

        return registros

    except Exception as e:
        print(f" [ERROR-PROCESO] Falló la consulta para RUC {ruc}: {e}")
        return []
    finally:
        await page.close()
        await context.close()


