def construir_url_detalle_pago(ruc, registro):
    """
    CONFIRMADA por el usuario y por capturas reales: es la misma URL que ya
    usaba en producción desde Visual FoxPro para ver el detalle de cada pago.
    https://ww1.sunat.gob.pe/cl-ti-itveripagformul/vpS01Alias
        ?accion=consulta&ruc=...&formulario=...&tipnro=01&nroorden=...
    """
    params = {
        "accion": "consulta",
        "ruc": ruc,
        "formulario": registro["num_formulario"],
        "tipnro": "01",
        "nroorden": registro["num_orden"],
    }
    query = urllib.parse.urlencode(params)
    return f"https://ww1.sunat.gob.pe/cl-ti-itveripagformul/vpS01Alias?{query}"


async def extraer_detalle_pago(page):
    """
    Extrae la tabla tblVeriPagoRptaUno: Casilla | Codigo - Descripción del Tributo | Importe.
    Confirmado con capturas reales — el código y la descripción vienen juntos en una
    sola celda separados por guion (ej. '1011-IGV - OPER. INT. - CTA. PROPIA'),
    y el importe usa PUNTO decimal aquí (a diferencia de la grilla principal, que usa coma).
    """
    await page.wait_for_selector("#tblVeriPagoRptaUno", timeout=15000)

    resultados = []
    while True:
        filas = await page.query_selector_all("#tblVeriPagoRptaUno tbody tr")
        for fila in filas:
            celdas = await fila.query_selector_all("td")
            if len(celdas) < 3:
                continue  # fila "Ningún dato disponible en esta tabla" (colspan=3, 1 sola td)

            casilla = (await celdas[0].inner_text()).strip()
            codigo_desc = (await celdas[1].inner_text()).strip()
            importe_txt = (await celdas[2].inner_text()).strip()

            if "-" in codigo_desc:
                codigo, descripcion = codigo_desc.split("-", 1)
                codigo, descripcion = codigo.strip(), descripcion.strip()
            else:
                codigo, descripcion = codigo_desc, None

            try:
                importe = float(importe_txt)
            except Exception:
                importe = None

            resultados.append({
                "casilla": casilla,
                "codigo_tributo": codigo,
                "descripcion_tributo": descripcion,
                "importe": importe,
            })

        boton_siguiente = await page.query_selector("#tblVeriPagoRptaUno_next")
        if not boton_siguiente:
            break
        clases = await boton_siguiente.get_attribute("class") or ""
        if "disabled" in clases:
            break
        await boton_siguiente.click()
        await page.wait_for_timeout(1000)

    return resultados


async def procesar_detalle_pago(page, ruc, registro, guardar_diagnostico=False):
    url = construir_url_detalle_pago(ruc, registro)
    await page.goto(url, timeout=30000)
    await page.wait_for_timeout(1500)

    if guardar_diagnostico:
        ruta_html = os.path.join(CARPETA_SALIDA, f"detalle_pago_{registro['num_orden']}.html")
        with open(ruta_html, "w", encoding="utf-8") as f:
            f.write(await page.content())
        print(f" [DIAGNÓSTICO] Guardado {ruta_html} (referencia de respaldo).")

    return await extraer_detalle_pago(page)


async def guardar_detalle_tributos_supabase(num_orden, filas_detalle):
    """
    detalle_tributos_pagos no tiene unique constraint más allá de 'id', así que
    para que correr el bot varias veces no duplique, borramos el detalle previo
    de ese num_orden y volvemos a insertar.
    """
    if not filas_detalle:
        return
    for fila in filas_detalle:
        fila["num_orden"] = num_orden
    try:
        supabase.table("detalle_tributos_pagos").delete().eq("num_orden", num_orden).execute()
        resp = supabase.table("detalle_tributos_pagos").insert(filas_detalle).execute()
        print(f"   [SUPABASE] {len(resp.data)} fila(s) de detalle para orden {num_orden}.")
    except Exception as e:
        print(f"   [ERROR-SUPABASE] detalle_tributos_pagos (orden {num_orden}): {e}")


