async def run(ruc, usuario, clave, fecha_ini="22/11/2025", fecha_fin="30/11/2025"):
    async with async_playwright() as p:
        browser = await p.chromium.launch(
            headless=False,  # ponlo en True una vez confirmes que el detalle de tributos sale bien
            args=["--start-maximized", "--disable-blink-features=AutomationControlled"]
        )
        await procesar_consulta_declaraciones(ruc, usuario, clave, browser, fecha_ini, fecha_fin)
        await browser.close()


