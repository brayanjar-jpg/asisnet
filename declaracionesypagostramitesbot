# PARTE 1: EXTRACCIÓN DE LA GRILLA PRINCIPAL (declaraciones y pagos)
# =====================================================================
async def extraer_declaraciones_pagos(page):
    print(" [SCRAPING] Extrayendo tabla de declaraciones y pagos...")
    await page.wait_for_selector("#tblDetalleDeclPagos", timeout=20000)

    resultados = []
    pagina_actual = 1

    while True:
        filas = await page.query_selector_all("#tblDetalleDeclPagos tbody tr")
        print(f"   -> Página {pagina_actual}: {len(filas)} filas")

        for fila in filas:
            celdas = await fila.query_selector_all("td")
            if len(celdas) < 10:
                continue

            resultados.append({
                "periodo":            (await celdas[1].inner_text()).strip(),
                "num_formulario":     (await celdas[2].inner_text()).strip(),
                "num_orden":          (await celdas[3].inner_text()).strip(),
                "descripcion":        (await celdas[4].inner_text()).strip(),
                "fecha_presentacion": (await celdas[5].inner_text()).strip(),
                "banco_receptor":     (await celdas[6].inner_text()).strip(),
                "codigo_tributo":     (await celdas[7].inner_text()).strip(),
                "importe_pagado":     (await celdas[9].inner_text()).strip(),
            })

        boton_siguiente = await page.query_selector("#tblDetalleDeclPagos_next")
        if not boton_siguiente:
            break
        clases = await boton_siguiente.get_attribute("class") or ""
        if "disabled" in clases:
            break

        await boton_siguiente.click()
        await page.wait_for_timeout(1500)
        pagina_actual += 1

    print(f" [SCRAPING] Total de registros extraídos: {len(resultados)}")
    return resultados


async def guardar_declaraciones_supabase(ruc, registros):
    """Upsert en declaraciones_pagos usando num_orden (UNIQUE) como llave."""
    if not registros:
        return []

    filas = []
    for r in registros:
        filas.append({
            "empresa_ruc": ruc,
            "periodo": r["periodo"],
            "num_formulario": r["num_formulario"],
            "num_orden": r["num_orden"],
            "descripcion_formulario": r["descripcion"],
            "fecha_presentacion": _fecha_a_iso(r["fecha_presentacion"]),
            "banco_receptor": r["banco_receptor"],
        })

    try:
        resp = (
            supabase.table("declaraciones_pagos")
            .upsert(filas, on_conflict="num_orden")
            .execute()
        )
        print(f" [SUPABASE] {len(resp.data)} filas en declaraciones_pagos.")
        return resp.data
    except Exception as e:
        print(f" [ERROR-SUPABASE] declaraciones_pagos: {e}")
        return []


