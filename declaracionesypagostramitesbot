def _fecha_a_iso(fecha_ddmmaaaa: str):
    """'01/06/2026' -> '2026-06-01' (formato date de Postgres). None si no matchea."""
    try:
        d, m, a = fecha_ddmmaaaa.strip().split("/")
        return f"{a}-{m}-{d}"
    except Exception:
        return None


def _indice_columna(headers, palabras_clave):
    for i, h in enumerate(headers):
        h_up = h.upper()
        if any(p in h_up for p in palabras_clave):
            return i
    return None


def _importe_a_float(valor: str):
    try:
        return float(valor.strip().replace(".", "").replace(",", "."))
    except Exception:
        return None


