package com.example.asisnet_contable

import android.content.Intent
import android.net.Uri
import android.widget.Toast
import androidx.compose.foundation.background
import androidx.compose.foundation.clickable
import androidx.compose.foundation.layout.*
import androidx.compose.foundation.lazy.LazyColumn
import androidx.compose.foundation.lazy.items
import androidx.compose.foundation.shape.RoundedCornerShape
import androidx.compose.material3.*
import androidx.compose.runtime.*
import androidx.compose.ui.Alignment
import androidx.compose.ui.Modifier
import androidx.compose.ui.graphics.Color
import androidx.compose.ui.platform.LocalContext
import androidx.compose.ui.text.font.FontWeight
import androidx.compose.ui.unit.dp
import androidx.compose.ui.unit.sp

@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun DdjjDashboard(
    rucUsuario: String,
    listaDdjj: List<ObligacionSunat>,
    cargandoDdjj: Boolean,
    onVolver: () -> Unit
) {
    val context = LocalContext.current
    var mostrarMenuAdjuntos by remember { mutableStateOf(false) }
    var urlConstanciaSeleccionada by remember { mutableStateOf("") }
    var urlDetallePdtSeleccionada by remember { mutableStateOf("") }

    Scaffold(
        topBar = {
            TopAppBar(
                title = { Text("Declaraciones Juradas y Pagos", fontSize = 20.sp, fontWeight = FontWeight.SemiBold) },
                navigationIcon = {
                    TextButton(onClick = onVolver) {
                        Text("< Volver", fontSize = 16.sp, fontWeight = FontWeight.SemiBold)
                    }
                },
                colors = TopAppBarDefaults.topAppBarColors(containerColor = Color.White)
            )
        }
    ) { paddingValues ->
        Box(modifier = Modifier.padding(paddingValues).fillMaxSize().background(Color(0xFFF4F6F9))) {
            if (cargandoDdjj) {
                CircularProgressIndicator(modifier = Modifier.align(Alignment.Center), color = Color(0xFF6750A4))
            } else if (listaDdjj.isEmpty()) {
                Text(
                    text = "No se encontraron obligaciones tributarias mapeadas.",
                    modifier = Modifier.align(Alignment.Center).padding(24.dp),
                    style = MaterialTheme.typography.bodyLarge, color = Color.Gray
                )
            } else {
                LazyColumn(
                    modifier = Modifier.fillMaxSize().padding(vertical = 4.dp),
                    verticalArrangement = Arrangement.spacedBy(4.dp)
                ) {
                    items(listaDdjj) { ddjj ->
                        Row(
                            modifier = Modifier
                                .fillMaxWidth()
                                .height(IntrinsicSize.Min)
                                .background(Color(0xFFFAFAFA))
                                .padding(vertical = 12.dp, horizontal = 16.dp),
                            verticalAlignment = Alignment.CenterVertically
                        ) {
                            // 🎨 CONTROL REACIVIO DE COLOR SEGÚN TU VISTA DE SUPABASE
                            val colorSemafortoDdjj = when (ddjj.colorSemaforo) {
                                "ROJO" -> Color(0xFFCE0D0E)     // 🚨 Omiso / Riesgo de Multa
                                "NARANJA" -> Color(0xFFFF9200)  // ⚠️ Próximo a vencer
                                "VERDE" -> Color(0xFF00B27E)    // ✅ Presentado
                                else -> Color(0xFF9E9E9E)       // ⚪ Gris (A tiempo)
                            }

                            // Franja de Alerta Lateral
                            Box(modifier = Modifier.width(5.dp).fillMaxHeight().background(colorSemafortoDdjj))
                            Spacer(modifier = Modifier.width(16.dp))

                            // Bloque de Datos del PDT
                            Column(modifier = Modifier.weight(1f).wrapContentHeight()) {
                                Text(
                                    text = "${ddjj.pdtCodigo} - ${ddjj.pdtNombre}",
                                    fontWeight = FontWeight.Bold, fontSize = 14.sp, color = Color(0xFF333333)
                                )
                                Spacer(modifier = Modifier.height(4.dp))
                                Row(horizontalArrangement = Arrangement.spacedBy(12.dp)) {
                                    Text(text = "Período: ${ddjj.periodo}", fontSize = 12.sp, color = Color.Gray)
                                    Text(text = "Orden: ${ddjj.numOrden ?: "-------"}", fontSize = 12.sp, color = Color.Gray)
                                }
                                Spacer(modifier = Modifier.height(4.dp))

                                val fechaTexto = ddjj.fechaPresentacion ?: "Vence el: ${ddjj.fechaVencimiento}"
                                Text(
                                    text = if (ddjj.numOrden != null) "Presentado: $fechaTexto" else fechaTexto,
                                    fontSize = 11.sp,
                                    color = if (ddjj.colorSemaforo == "ROJO") Color(0xFFCE0D0E) else Color.Gray,
                                    fontWeight = if (ddjj.colorSemaforo == "ROJO") FontWeight.SemiBold else FontWeight.Normal
                                )

                                Spacer(modifier = Modifier.height(6.dp))
                                Box(
                                    modifier = Modifier
                                        .background(color = colorSemafortoDdjj, shape = RoundedCornerShape(3.dp))
                                        .padding(horizontal = 8.dp, vertical = 3.dp)
                                ) {
                                    val textoBadge = if (ddjj.numOrden != null) "ORIGINAL" else ddjj.estadoDescripcion
                                    Text(text = textoBadge.uppercase(), color = Color.White, fontSize = 11.sp, fontWeight = FontWeight.Bold)
                                }
                            }
                            // 📊 COLUMNA DE DOSIFICACIÓN DE IMPORTES MONETARIOS Y CONTROL DE ADJUNTOS
                            Column(horizontalAlignment = Alignment.End, modifier = Modifier.padding(start = 8.dp)) {
                                Text(
                                    text = "S/. ${String.format("%.2f", ddjj.totalPagado)}",
                                    fontWeight = FontWeight.Bold, fontSize = 14.sp,
                                    color = if (ddjj.numOrden != null) Color(0xFF00B27E) else Color(0xFF333333)
                                )
                                Spacer(modifier = Modifier.height(10.dp))

                                // Si está presentado y el bot ya subió los archivos a Supabase Storage
                                if (ddjj.numOrden != null && (ddjj.urlPdfConstancia.isNotEmpty() || ddjj.urlPdfDetallePdt.isNotEmpty())) {
                                    Row(
                                        modifier = Modifier
                                            .background(color = colorSemafortoDdjj.copy(alpha = 0.08f), shape = RoundedCornerShape(6.dp))
                                            .clickable {
                                                urlConstanciaSeleccionada = ddjj.urlPdfConstancia
                                                urlDetallePdtSeleccionada = ddjj.urlPdfDetallePdt
                                                mostrarMenuAdjuntos = true
                                            }
                                            .padding(horizontal = 8.dp, vertical = 4.dp),
                                        verticalAlignment = Alignment.CenterVertically
                                    ) {
                                        Text(text = "📎 PDF", fontSize = 12.sp, color = colorSemafortoDdjj, fontWeight = FontWeight.Bold)
                                    }
                                } else if (ddjj.numOrden != null) {
                                    Text(text = "Sin adjunto", fontSize = 11.sp, color = Color.LightGray)
                                } else {
                                    Text(text = "Pendiente", fontSize = 11.sp, color = Color(0xFFFF9200), fontWeight = FontWeight.Medium)
                                }
                            }
                        }
                        HorizontalDivider(color = Color(0xFFE0E0E0), thickness = 1.dp)
                    }
                }
            }
        }
    }

    // =====================================================================
    // 📂 MODAL FLOTANTE CONTEXTUAL DE ADJUNTOS DUPLICADOS (CON CARD COMPOSE)
    // =====================================================================
    if (mostrarMenuAdjuntos) {
        AlertDialog(
            onDismissRequest = { mostrarMenuAdjuntos = false },
            title = { Text(text = "Seleccione el Documento", fontWeight = FontWeight.Bold, fontSize = 18.sp) },
            text = {
                Column(verticalArrangement = Arrangement.spacedBy(12.dp), modifier = Modifier.fillMaxWidth().padding(top = 8.dp)) {
                    if (urlConstanciaSeleccionada.isNotEmpty()) {
                        Card(
                            onClick = {
                                try {
                                    context.startActivity(Intent(Intent.ACTION_VIEW, Uri.parse(urlConstanciaSeleccionada)).apply { addFlags(Intent.FLAG_ACTIVITY_NEW_TASK) })
                                } catch (e: Exception) { Toast.makeText(context, "Error al abrir constancia", Toast.LENGTH_SHORT).show() }
                                mostrarMenuAdjuntos = false
                            },
                            colors = CardDefaults.cardColors(containerColor = Color(0xFFF4F6F9)),
                            shape = RoundedCornerShape(12.dp), modifier = Modifier.fillMaxWidth()
                        ) {
                            Row(modifier = Modifier.padding(14.dp).fillMaxWidth(), verticalAlignment = Alignment.CenterVertically) {
                                Text(text = "📄", fontSize = 24.sp)
                                Spacer(modifier = Modifier.width(14.dp))
                                Column {
                                    Text(text = "Constancia de Presentación", fontWeight = FontWeight.Bold, fontSize = 14.sp, color = Color(0xFF6750A4))
                                    Text(text = "Comprobante oficial de SUNAT con N° Orden", fontSize = 11.sp, color = Color.Gray)
                                }
                            }
                        }
                    }

                    if (urlDetallePdtSeleccionada.isNotEmpty()) {
                        Card(
                            onClick = {
                                try {
                                    context.startActivity(Intent(Intent.ACTION_VIEW, Uri.parse(urlDetallePdtSeleccionada)).apply { addFlags(Intent.FLAG_ACTIVITY_NEW_TASK) })
                                } catch (e: Exception) { Toast.makeText(context, "Error al abrir detalle", Toast.LENGTH_SHORT).show() }
                                mostrarMenuAdjuntos = false
                            },
                            colors = CardDefaults.cardColors(containerColor = Color(0xFFF4F6F9)),
                            shape = RoundedCornerShape(12.dp), modifier = Modifier.fillMaxWidth()
                        ) {
                            Row(modifier = Modifier.padding(14.dp).fillMaxWidth(), verticalAlignment = Alignment.CenterVertically) {
                                Text(text = "📊", fontSize = 24.sp)
                                Spacer(modifier = Modifier.width(14.dp))
                                Column {
                                    Text(text = "Reporte Detallado del PDT", fontWeight = FontWeight.Bold, fontSize = 14.sp, color = Color(0xFF6750A4))
                                    Text(text = "Desglose de casillas, tributos e importes", fontSize = 11.sp, color = Color.Gray)
                                }
                            }
                        }
                    }
                }
            },
            confirmButton = {
                TextButton(onClick = { mostrarMenuAdjuntos = false }) { Text("Cancelar", color = Color.Gray) }
            },
            shape = RoundedCornerShape(24.dp), containerColor = Color.White
        )
    }
}
