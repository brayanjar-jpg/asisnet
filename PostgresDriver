    suspend fun obtenerDeclaracionesPorCliente(rucInput: String): List<Map<String, String>> = withContext(Dispatchers.IO) {
        val listaTemporal = mutableListOf<Map<String, String>>()

        val query = """
            SELECT 
                d.num_formulario,
                d.des_formulario,
                d.num_orden,
                d.periodo,
                TO_CHAR(d.fecha_presentacion, 'DD/MM/YYYY') as fecha_formateada,
                COALESCE(d.total_pagado, 0.00) as total_pagado,
                COALESCE(d.tipo_declaracion, 'Original') as tipo_declaracion,
                COALESCE((SELECT a.url_storage FROM public.declaraciones_adjuntos a 
                          WHERE a.ruc = d.ruc AND a.num_orden = d.num_orden AND a.nombre_archivo LIKE 'constancia_%' LIMIT 1), '') as url_constancia,
                COALESCE((SELECT a.url_storage FROM public.declaraciones_adjuntos a 
                          WHERE a.ruc = d.ruc AND a.num_orden = d.num_orden AND a.nombre_archivo LIKE 'detalle_%' LIMIT 1), '') as url_detalle
            FROM public.declaraciones_sunat d
            WHERE d.ruc = ?
            ORDER BY d.fecha_presentacion DESC
        """.trimIndent()

        var conexion: Connection? = null
        try {
            conexion = getConnection()
            conexion.prepareStatement(query).use { stmt ->
                stmt.setString(1, rucInput.trim())
                stmt.executeQuery().use { rs ->
                    while (rs.next()) {
                        val registro = HashMap<String, String>()

                        registro.put("formulario", rs.getString("num_formulario") ?: "0621")
                        registro.put("descripcion", rs.getString("des_formulario") ?: "DECLARACIÓN JURADA")
                        registro.put("orden", rs.getString("num_orden") ?: "S/N")
                        registro.put("periodo", rs.getString("periodo") ?: "")
                        registro.put("fecha", rs.getString("fecha_formateada") ?: "")
                        registro.put("total", String.format("%.2f", rs.getDouble("total_pagado")))
                        registro.put("tipoDeclaracion", rs.getString("tipo_declaracion") ?: "Original")
                        registro.put("urlPdf", rs.getString("url_constancia") ?: "")
                        registro.put("urlPdfDetalle", rs.getString("url_detalle") ?: "")

                        listaTemporal.add(registro)
                    }
                }
            }
        } catch (e: Exception) {
            e.printStackTrace()
        } finally {
            try { conexion?.close() } catch (e: Exception) { e.printStackTrace() }
        }
        return@withContext listaTemporal
    }

