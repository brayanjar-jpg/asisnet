    // =====================================================================
    // --- GESTIÓN DE CONTROL MULTI-AFP CON DESGLOSE NOMINAL Y PAGO REAL ---
    // =====================================================================
    // 🚀 CORREGIDO: Firma fuertemente tipada con el modelo estructural PlanillaAfpEntidad
    suspend fun obtenerPlanillasAfpPorCliente(rucInput: String): List<PlanillaAfpEntidad> = withContext(Dispatchers.IO) {
        val listaTemporal = mutableListOf<PlanillaAfpEntidad>()

        val query = """
            SELECT 
                '202607' as periodo_auditoria,
                c.afp_nombre,
                COALESCE(p.num_planilla, 'POR DECLARAR') as planilla_vigente,
                COALESCE(TO_CHAR(p.fecha_declaracion, 'DD/MM/YYYY'), 'Sin fecha') as fecha_formateada,
                COALESCE(p.total_deuda_afp, 0.00) as total_afp,
                COALESCE(p.nominal_fondo, 0.00) as fondo,
                COALESCE(p.nominal_ryr, 0.00) as ryr,
                COALESCE(p.num_trabajadores, 0) as trabajadores,
                CASE 
                    WHEN p.num_planilla IS NOT NULL AND t.num_ticket IS NULL THEN 'Planilla Declarada'
                    WHEN p.num_planilla IS NULL THEN 'Pendiente de Declarar'
                    ELSE COALESCE(t.estado_pago, 'Planilla Declarada')
                END as estado_calculado,
                COALESCE(t.num_ticket, 'Sin Ticket Emitido') as ticket_vigente,
                COALESCE(TO_CHAR(t.fecha_expiracion, 'DD/MM/YYYY'), 'S/V') as vencimiento_ticket,
                COALESCE(t.fecha_pago_real_str, 'Sin Pago') as fecha_pago_real, 
                GREATEST(0, (
                    SELECT COUNT(*) FROM public.empresa_trabajadores_maestro m 
                    WHERE m.ruc = c.ruc AND m.activo_planilla = true AND m.afp_afiliado = c.afp_nombre
                ) - COALESCE(p.num_trabajadores, 0)) as trabajadores_omitidos,
                COALESCE((SELECT a.url_storage FROM public.afp_adjuntos a 
                          WHERE a.ruc = c.ruc AND a.identificador_ref = p.num_planilla AND a.tipo_documento = 'PDF_PLANILLA' LIMIT 1), '') as url_planilla_pdf,
                COALESCE((SELECT a.url_storage FROM public.afp_adjuntos a 
                          WHERE a.ruc = c.ruc AND a.identificador_ref = t.num_ticket AND a.tipo_documento = 'PDF_TICKET' LIMIT 1), '') as url_ticket_pdf
            FROM public.afp_config_empresa c
            LEFT JOIN public.afp_planillas p ON c.ruc = p.ruc AND p.periodo = '202607' AND c.afp_nombre = p.afp_nombre
            LEFT JOIN public.afp_tickets t ON p.ruc = t.ruc AND p.num_planilla = t.num_planilla AND t.vigente = true AND p.afp_nombre = t.afp_nombre
            WHERE c.ruc = ? AND c.espera_declaracion = true
            ORDER BY c.afp_nombre ASC
        """.trimIndent()

        var conexion: Connection? = null
        try {
            conexion = getConnection()
            conexion.prepareStatement(query).use { stmt ->
                stmt.setString(1, rucInput.trim())
                stmt.executeQuery().use { rs ->
                    while (rs.next()) {
                        val afpNombre = rs.getString("afp_nombre") ?: "AFP"
                        val planillaNum = rs.getString("planilla_vigente") ?: "POR DECLARAR"

                        // 🎯 MAPEO DIRECTO AL MODELO REFACTORIZADO DE ANDROID
                        listaTemporal.add(
                            PlanillaAfpEntidad(
                                periodo = rs.getString("periodo_auditoria") ?: "202607",
                                planilla = "$afpNombre ($planillaNum)",
                                fecha = rs.getString("fecha_formateada") ?: "Sin fecha",
                                total = String.format("%.2f", rs.getDouble("total_afp")),
                                fondo = String.format("%.2f", rs.getDouble("fondo")),
                                ryr = String.format("%.2f", rs.getDouble("ryr")),
                                trabajadores = rs.getInt("trabajadores").toString(),
                                estadoTicket = rs.getString("estado_calculado") ?: "Pendiente de Declarar",
                                omitidos = rs.getInt("trabajadores_omitidos").toString(),
                                ticket = rs.getString("ticket_vigente") ?: "Sin Ticket",
                                vencimiento = rs.getString("vencimiento_ticket") ?: "S/V",
                                fechaPago = rs.getString("fecha_pago_real") ?: "Sin Pago",
                                urlPdf = rs.getString("url_planilla_pdf") ?: "",
                                urlPdfTicket = rs.getString("url_ticket_pdf") ?: ""
                            )
                        )
                    }
                }
            }
        } catch (e: Exception) {
            e.printStackTrace()
        } finally {
            try { conexion?.close() } catch (e: Exception) { e.printStackTrace() }
        }
        return@withContext listaTemporal
    }

