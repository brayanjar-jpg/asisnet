    // --- EVOLUCIONADO: EXTRAE LOS 9 PARÁMETROS DEL BUZÓN CON COPILACIÓN DE CONEXIÓN SEGURA ---
    suspend fun obtenerBuzonPorCliente(rucInput: String): List<NotificacionSunat> = withContext(Dispatchers.IO) {
        val listaTemporal = mutableListOf<NotificacionSunat>()

        val query = """
            SELECT 
                n.asunto, 
                n.fecha_hora, 
                n.estado, 
                n.num_resolucion, 
                n.etiqueta, 
                n.leido_app, 
                COALESCE(d.cuerpo_completo, 'Este mensaje no contiene un cuerpo de texto extraído.') as cuerpo_completo,
                (SELECT a.url_storage FROM public.notificaciones_adjuntos a 
                 WHERE a.ruc = n.ruc AND a.num_resolucion = n.num_resolucion AND a.origen = 'ADJUNTO' LIMIT 1) as url_cabecera,
                (SELECT a.url_storage FROM public.notificaciones_adjuntos a 
                 WHERE a.ruc = n.ruc AND a.num_resolucion = n.num_resolucion AND a.origen = 'CUERPO' LIMIT 1) as url_cuerpo
            FROM public.notificaciones_sunat n
            LEFT JOIN public.notificaciones_detalles d ON n.ruc = d.ruc AND n.num_resolucion = d.num_resolucion
            WHERE n.ruc = ? 
            ORDER BY n.fecha_hora DESC
        """.trimIndent()

        var conexion: Connection? = null
        try {
            conexion = getConnection()
            conexion.prepareStatement(query).use { stmt ->
                stmt.setString(1, rucInput.trim())
                stmt.executeQuery().use { rs ->
                    while (rs.next()) {
                        val timestampRaw = rs.getTimestamp("fecha_hora")
                        val fechaFormateada = timestampRaw?.toString() ?: "Sin Fecha"

                        listaTemporal.add(
                            NotificacionSunat(
                                asunto = rs.getString("asunto") ?: "Sin Asunto",
                                fechaHora = fechaFormateada,
                                estado = rs.getString("estado") ?: "REVISADO",
                                numResolucion = rs.getString("num_resolucion") ?: "S/N",
                                etiqueta = rs.getString("etiqueta") ?: "",
                                leidoApp = rs.getBoolean("leido_app"),
                                // 🎯 CORREGIDO: Blindaje elvis contra nulos para evitar NullPointerException en Android
                                contenidoCuerpo = rs.getString("cuerpo_completo") ?: "Este mensaje no contiene un cuerpo de texto extraído.",
                                urlPdfCabecera = rs.getString("url_cabecera") ?: "",
                                urlPdfCuerpo = rs.getString("url_cuerpo") ?: ""
                            )
                        )
                    }
                }
            }
        } catch (e: Exception) {
            e.printStackTrace()
        } finally {
            try { conexion?.close() } catch (e: Exception) { e.printStackTrace() }
        }
        return@withContext listaTemporal
    }
    suspend fun cambiarEstadoLeidoApp(rucInput: String, numResolucionInput: String, nuevoEstado: Boolean): Boolean = withContext(Dispatchers.IO) {
        val query = """
            UPDATE public.notificaciones_sunat 
            SET leido_app = ? 
            WHERE ruc = ? AND num_resolucion = ?
        """.trimIndent()

        var conexion: Connection? = null
        var exito = false // 🎯 CORREGIDO: Variable de retorno local para evitar que el 'return' rompa el flujo del finally
        try {
            conexion = getConnection()
