    // 🚀 CORREGIDO: Firma fuertemente tipada con el modelo estructural PlanillaAfpEntidad
    suspend fun obtenerPlanillasAfpPorCliente(rucInput: String): List<PlanillaAfpEntidad> = withContext(Dispatchers.IO) {
        val listaTemporal = mutableListOf<PlanillaAfpEntidad>()

        val query = """
        SELECT
            periodo_auditoria,
            afp_nombre,
            planilla_vigente,
            fecha_formateada,
            total_afp,
            fondo,
            ryr,
            trabajadores,
            ticket_vigente,
            vencimiento_ticket,
            fecha_pago_real,
            estado_pago_ticket,
            trabajadores_omitidos,
            color_semaforo,
            estado_cumplimiento,
            url_planilla_pdf,
            url_ticket_pdf
        FROM public.v_dashboard_afp_planillas
        WHERE ruc = ?
    """.trimIndent()

        var conexion: Connection? = null
        try {
            conexion = getConnection()
            conexion.prepareStatement(query).use { stmt ->
                stmt.setString(1, rucInput.trim())
                stmt.executeQuery().use { rs ->
                    while (rs.next()) {
                        val afpNombre = rs.getString("afp_nombre") ?: "AFP"
                        val planillaNum = rs.getString("planilla_vigente") ?: "POR DECLARAR"

                        // Estado visible del ticket: si la planilla ya está declarada usamos
                        // el estado_cumplimiento de la vista salvo que el ticket ya esté pagado
                        val estadoPagoTicket = rs.getString("estado_pago_ticket") ?: "Pendiente"
                        val estadoTicketMostrado = if (estadoPagoTicket.contains("Pagad", ignoreCase = true)) {
                            estadoPagoTicket
                        } else {
                            rs.getString("estado_cumplimiento") ?: "Pendiente de Declarar"
                        }

                        listaTemporal.add(
                            PlanillaAfpEntidad(
                                periodo = rs.getString("periodo_auditoria") ?: "",
                                planilla = "$afpNombre ($planillaNum)",
                                fecha = rs.getString("fecha_formateada") ?: "Sin fecha",
                                total = String.format("%.2f", rs.getDouble("total_afp")),
                                fondo = String.format("%.2f", rs.getDouble("fondo")),
                                ryr = String.format("%.2f", rs.getDouble("ryr")),
                                trabajadores = rs.getInt("trabajadores").toString(),
                                estadoTicket = estadoTicketMostrado,
                                omitidos = rs.getInt("trabajadores_omitidos").toString(),
                                ticket = rs.getString("ticket_vigente") ?: "Sin Ticket",
                                vencimiento = rs.getString("vencimiento_ticket") ?: "S/V",
                                fechaPago = rs.getString("fecha_pago_real") ?: "Sin pago",
                                urlPdf = rs.getString("url_planilla_pdf") ?: "",
                                urlPdfTicket = rs.getString("url_ticket_pdf") ?: "",
                                colorSemaforo = rs.getString("color_semaforo") ?: "GRIS",
                                estadoCumplimiento = rs.getString("estado_cumplimiento") ?: "Pendiente"
                            )
                        )
                    }
                }
            }
        } catch (e: Exception) {
            e.printStackTrace()
        } finally {
            try { conexion?.close() } catch (e: Exception) { e.printStackTrace() }
        }
        return@withContext listaTemporal
    }

