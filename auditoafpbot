                estado_portal_raw = fila_blanco.find_element(By.XPATH, "./td[11]").text 

                fondo_clean = float(re.sub(r"[^\d.]", "", nominal_fondo_raw.strip())) if nominal_fondo_raw else 0.00
                ryr_clean = float(re.sub(r"[^\d.]", "", nominal_ryr_raw.strip())) if nominal_ryr_raw else 0.00
                total_clean = float(re.sub(r"[^\d.]", "", total_deuda.strip())) if total_deuda else 0.00
                
                fecha_pago_real = fecha_pago_raw.strip() if (fecha_pago_raw and "---" not in fecha_pago_raw) else "Sin Pago"
                estado_pago_calculado = "Pagado" if "PAGADA" in estado_portal_raw.upper() else "Planilla Declarada"
                
                fecha_exp_postgres = datetime.now(zona_peru).strftime("%Y-%m-%d 23:59:59")
