def verificar_ventana_mantenimiento_afpnet():
    """
    Control de Corto Circuito por Horario: Detiene el bot si el portal de AFPnet
    se encuentra fuera de línea por mantenimiento técnico diario (11:00 PM - 5:00 AM).
    Garantiza consistencia horaria en producción cloud forzando la zona 'America/Lima'.
    """
    zona_peru = ZoneInfo("America/Lima")
    ahora_peru = datetime.now(zona_peru).time()
    
    hora_inicio_mantenimiento = datetime.strptime("23:00:00", "%H:%M:%S").time()
    hora_fin_mantenimiento = datetime.strptime("05:05:00", "%H:%M:%S").time() # Tolerancia de 5 minutos

    if ahora_peru >= hora_inicio_mantenimiento or ahora_peru <= hora_fin_mantenimiento:
        print(f"\n{'!'*80}")
        print(f"[🛡️ GUARDIA DE HORARIO OMNIPRESENTE] Ejecución pausada de forma preventiva.")
        print(f"   Hora Oficial Perú: {ahora_peru.strftime('%H:%M:%S')} | AFPnet se encuentra fuera de servicio.")
        print(f"   El bot se reactivará de manera automatizada a partir de las 05:06 AM (Hora Lima).")
        print(f"{'!'*80}\n")
        return False
    return True

