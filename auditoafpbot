            btn_cerrar = wait.until(EC.element_to_be_clickable((By.CSS_SELECTOR, "button.close[data-dismiss='modal']")))
            driver.execute_script("arguments[0].click();", btn_cerrar)
            time.sleep(2.0)
        except: pass

        # BUCLE NEURONAL DE CAPTCHAS CON MODELACIÓN BIOMÉTRICA PAUSADA
        intentos, max_intentos = 0, 10
        login_exitoso = False
        while intentos < max_intentos:
            intentos += 1
            print(f"   [CAPTCHA] Intento de descifrado {intentos}/{max_intentos}...")

            txt_ruc = wait.until(EC.element_to_be_clickable((By.ID, "NumeroDocumento")))
            txt_usuario = driver.find_element(By.ID, "NombreUsuario")
            txt_password = driver.find_element(By.ID, "Contrasenia")
            txt_captcha_input = driver.find_element(By.ID, "Captcha")
            captcha_element = wait.until(EC.presence_of_element_located((By.ID, "CaptchaImg")))

            txt_ruc.clear()
            txt_ruc.send_keys(ruc)
            txt_usuario.clear()
            txt_usuario.send_keys(usuario_afp)
            txt_password.clear()
            txt_password.send_keys(clave_afp)
            time.sleep(1.5)

            captcha_base64 = captcha_element.screenshot_as_base64
            captcha_bytes = base64.b64decode(captcha_base64)
            captcha_detectado = ocr.classification(captcha_bytes).strip().upper()
            print(f"   [NEURONAL] Red interpretó el patrón como: '{captcha_detectado}'")

            if len(captcha_detectado) != 4:
                captcha_element.click()
                time.sleep(1.8)
                continue

            txt_captcha_input.clear()
            time.sleep(0.4)
            for letra in captcha_detectado:
                txt_captcha_input.send_keys(letra)
                time.sleep(0.2)
            time.sleep(1.0)

            if txt_captcha_input.get_attribute("value") != captcha_detectado:
                continue

            btn_ingresar = driver.find_element(By.ID, "btn-ingresar")
            btn_ingresar.click()
            time.sleep(5.5)

            if "IniciarSesion" not in driver.current_url and "login" not in driver.current_url.lower():
                print("   [IA-WEB] ¡Ingreso exitoso al entorno privado de AFPnet!")
