def comprobar_y_caducar_tickets_antiguos(ruc, fecha_hoy):
    """
    IA Preventiva: El bot de lectura degrada de inmediato en Supabase los tickets 
    que ya vencieron en calendario, forzando a la app a exigir uno nuevo.
    """
    try:
        query = supabase.table("afp_tickets").select("num_ticket, fecha_expiracion").eq("ruc", ruc).eq("vigente", True).execute()
        for tk in query.data:
            f_exp = datetime.strptime(tk["fecha_expiracion"].split("T")[0], "%Y-%m-%d")
            if f_exp < fecha_hoy:
                print(f"   [⏳ CADUCADO] El ticket N° {tk['num_ticket']} expiró. Marcando como no vigente.")
                supabase.table("afp_tickets").update({"vigente": False, "estado_pago": "Caducado"}).eq("ruc", ruc).eq("num_ticket", tk["num_ticket"]).execute()
    except Exception as e:
        print(f"   [AVISO] Control de caducidades omitido por consistencia: {str(e)}")
def ejecutar_barrido_auditoria_afpnet(driver, wait, ruc_raw, usuario_afp, clave_afp, nombre_afp_objetivo):
