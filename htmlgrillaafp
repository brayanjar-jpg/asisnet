                lcSQL = "UPDATE proceso_resumen_sire_compras SET estado_barrido = 'ERROR LOGIN', updated_at = NOW() WHERE id = " + ALLTRIM(STR(lnIdProceso)) + ";"
                =SQLEXEC(lnHandle, lcSQL)
                
                lcSQL = "UPDATE plantilla_resumen_sire SET estado_barrido = 'ERR CREDENCIAL' WHERE empresa_id = " + ALLTRIM(STR(curSireMensual.id)) + ";"
                =SQLEXEC(lnHandle, lcSQL)
            ENDIF
        ELSE
            * ?? SI EL ARCHIVO VIENE VACÍO POR TIMEOUT PERO SIN ALERTA DE ERROR DE LOGIN
            IF nLineas < 2 OR LEN(ALLTRIM(lcContenido)) < 5 OR "SIN OPER" $ UPPER(lcContenido)
                lcSQL = "UPDATE proceso_resumen_sire_compras SET " + ;
                        "estado_barrido = 'PROCESADO', updated_at = NOW(), total_documentos = 0, " + ;
                        "bi_gravado_dg = 0.00, igv_ipm_dg = 0.00, valor_adq_ng = 0.00, total_cp = 0.00 " + ;
                        "WHERE id = " + ALLTRIM(STR(lnIdProceso)) + ";"
                =SQLEXEC(lnHandle, lcSQL)
                
                lcSQL = "UPDATE plantilla_resumen_sire SET estado_barrido = 'PROCESADO' WHERE empresa_id = " + ALLTRIM(STR(curSireMensual.id)) + ";"
                =SQLEXEC(lnHandle, lcSQL)
            ELSE
                * --- PROCESAMIENTO ESTÁNDAR SI EL ARCHIVO TRAE LA FILA TOTAL ---
                lnFilaTotalC = 0
                FOR i = 2 TO nLineas
                    IF LEFT(UPPER(ALLTRIM(aLineas[i])), 5) == "TOTAL"
                        lnFilaTotalC = i
                        EXIT
                    ENDIF
                ENDFOR
                
                IF lnFilaTotalC = 0
                    lnFilaTotalC = nLineas
                ENDIF
                
                lcLineaFila = aLineas[lnFilaTotalC]
                nColsFila = ALINES(aValFila, STRTRAN(lcLineaFila, "|", CHR(13)))
                
                IF nColsFila >= 13 AND LEFT(UPPER(ALLTRIM(aValFila)), 5) == "TOTAL"
                    lcSQL = "UPDATE proceso_resumen_sire_compras SET " + ;
                            "estado_barrido = 'PROCESADO', updated_at = NOW(), total_documentos = " + ALLTRIM(aValFila) + ", " + ;
                            "bi_gravado_dg = " + ALLTRIM(STR(VAL(ALLTRIM(aValFila)), 12, 2)) + ", " + ;
                            "igv_ipm_dg = " + ALLTRIM(STR(VAL(ALLTRIM(aValFila)), 12, 2)) + ", " + ;
                            "valor_adq_ng = " + ALLTRIM(STR(VAL(ALLTRIM(aValFila)), 12, 2)) + ", " + ;
                            "total_cp = " + ALLTRIM(STR(VAL(ALLTRIM(aValFila)), 12, 2)) + " " + ;
                            "WHERE id = " + ALLTRIM(STR(lnIdProceso)) + ";"
                    =SQLEXEC(lnHandle, lcSQL)
                    
                    lcSQL = "UPDATE plantilla_resumen_sire SET estado_barrido = 'PROCESADO' WHERE empresa_id = " + ALLTRIM(STR(curSireMensual.id)) + ";"
                    =SQLEXEC(lnHandle, lcSQL)
                ENDIF
            ENDIF
        ENDIF
        DELETE FILE (lcArchivoResult)
    ELSE
        * Timeout general por caída del servicio web de SUNAT o corte de luz/internet
        lcSQL = "UPDATE proceso_resumen_sire_compras SET " + ;
                "estado_barrido = 'PROCESADO', updated_at = NOW(), total_documentos = 0, " + ;
                "bi_gravado_dg = 0.00, igv_ipm_dg = 0.00, valor_adq_ng = 0.00, total_cp = 0.00 " + ;
                "WHERE id = " + ALLTRIM(STR(lnIdProceso)) + ";"
        =SQLEXEC(lnHandle, lcSQL)
        
        lcSQL = "UPDATE plantilla_resumen_sire SET estado_barrido = 'PROCESADO' WHERE empresa_id = " + ALLTRIM(STR(curSireMensual.id)) + ";"
        =SQLEXEC(lnHandle, lcSQL)
    ENDIF
ENDSCAN

=SQLDISCONNECT(lnHandle)
WAIT CLEAR
ThisForm.CargarGridsResumen()
MESSAGEBOX("Barrido masivo de Compras finalizado con éxito y descarte automático de 0 movimientos.", 64, "Mensaje")
