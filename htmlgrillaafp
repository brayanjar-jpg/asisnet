LOCAL lcPeriodoRaw, lcMesTexto, lcAnoTexto, lcPeriodoSunat, lcConnectionString
LOCAL lnHandle, lnResult, lcSQL, lcComando, lnContador, lcArchivoResult
LOCAL lcContenido, nLineas, lnFilaTotalC, lcLineaFila, nColsFila, i
LOCAL lnRegistrosProcesados, lnIdProceso
* ?? EL ANCLA DEFINITIVA: Declaración forzada de matrices con tamaño inicial
LOCAL aLineas[1], aValFila[1], laError[1]

* 1. VALIDACIÓN DEL PERIODO EN FORMATO MM/AAAA
lcPeriodoRaw = ALLTRIM(ThisForm.pageframe1.page1.Text1.Value)
lcPeriodoRaw = STRTRAN(lcPeriodoRaw, "/", "")
lcPeriodoRaw = STRTRAN(lcPeriodoRaw, " ", "") 

IF LEN(lcPeriodoRaw) != 6 OR NOT ISDIGIT(lcPeriodoRaw)
    MESSAGEBOX("Ingrese un periodo válido en formato MM/AAAA (Ej: 08/2026).", 48, "Validación")
    ThisForm.pageframe1.page1.Text1.SetFocus()
    RETURN
ENDIF

lcMesTexto = LEFT(lcPeriodoRaw, 2)  
lcAnoTexto = RIGHT(lcPeriodoRaw, 4) 
lcPeriodoSunat = lcAnoTexto + lcMesTexto 

IF NOT USED("curSireMensual") OR RECCOUNT("curSireMensual") = 0
    MESSAGEBOX("No hay empresas cargadas en la plantilla maestra para procesar.", 64, "Aviso")
    RETURN
ENDIF

IF MESSAGEBOX("¿Desea iniciar el barrido masivo de COMPRAS con filtro inteligente de SUNAT?", 36, "Procesamiento Masivo") != 6
    RETURN
ENDIF

* 2. CONEXIÓN CON SUPABASE
lcConnectionString = "Driver={PostgreSQL ANSI(x86)};" + ;
                     "Server=aws-0-sa-east-1.pooler.supabase.com;" + ;
                     "Port=5432;" + ;
                     "Database=postgres;" + ;
                     "UID=postgres.atryivflkhjsynrqzora;" + ;
                     "PWD=Angelo2862*12;" + ;
                     "SSLmode=require;" + ;
                     "ConnSettings=SET client_encoding TO 'UTF8';"


lnHandle = SQLSTRINGCONNECT(lcConnectionString)

IF lnHandle <= 0
    =AERROR(laError)
    MESSAGEBOX("Error de conexión con Supabase: " + laError(2), 16, "Error")
    RETURN
ELSE
    =SQLEXEC(lnHandle, "SET TIME ZONE 'America/Lima';")
ENDIF

lnRegistrosProcesados = 0
SELECT curSireMensual
GO TOP

* 3. BUCLE DE RECORRIDO COMPLETO DE LA GRILLA
SCAN
    lnRegistrosProcesados = lnRegistrosProcesados + 1
    WAIT WINDOW "Procesando Compras (" + ALLTRIM(STR(lnRegistrosProcesados)) + "/" + ALLTRIM(STR(RECCOUNT("curSireMensual"))) + ") - RUC: " + ALLTRIM(curSireMensual.ruc) + "..." NOWAIT
    
    lcSQL = "UPDATE plantilla_resumen_sire SET estado_barrido = 'EN PROCESO' WHERE empresa_id = " + ALLTRIM(STR(curSireMensual.id)) + ";"
    =SQLEXEC(lnHandle, lcSQL)
    
    lcSQL = "INSERT INTO proceso_resumen_sire_compras (empresa_id, periodo_animes, estado_barrido) " + ;
            "VALUES (" + ALLTRIM(STR(curSireMensual.id)) + ", " + lcPeriodoSunat + ", 'PENDIENTE') " + ;
            "ON CONFLICT (empresa_id, periodo_animes) DO UPDATE SET empresa_id = EXCLUDED.empresa_id " + ;
            "RETURNING id;"
    lnResult = SQLEXEC(lnHandle, lcSQL, "curIdBusqueda")
    
    IF lnResult > 0 AND USED("curIdBusqueda") AND RECCOUNT("curIdBusqueda") > 0
        lnIdProceso = curIdBusqueda.id
        USE IN curIdBusqueda
    ELSE
        IF USED("curIdBusqueda")
            USE IN curIdBusqueda
        ENDIF
        LOOP 
    ENDIF
    
    lcArchivoResult = "D:\SIRE\resultado_resumen_compras.txt"
    IF FILE(lcArchivoResult)
        DELETE FILE (lcArchivoResult)
    ENDIF

    lcComando = 'cmd.exe /c python D:\SIRE\resumen_rce.py ' + ;
        '"compras" "' + lcPeriodoSunat + '" "' + ALLTRIM(curSireMensual.ruc) + '" "' + ;
        ALLTRIM(curSireMensual.usuario_sol) + '" "' + ALLTRIM(curSireMensual.clave_sol) + '" "' + ;
        ALLTRIM(curSireMensual.client_id) + '" "' + ALLTRIM(curSireMensual.client_secret) + '"'
        
    =WinExec(lcComando, 0)

    lnContador = 0
    DO WHILE !FILE(lcArchivoResult) AND lnContador < 150
        =INKEY(0.1, "H")
        lnContador = lnContador + 1
    ENDDO

    * 4. EVALUACIÓN INTELIGENTE DE RESPUESTAS SUNAT
    IF FILE(lcArchivoResult)
        lcContenido = FILETOSTR(lcArchivoResult)
        nLineas = ALINES(aLineas, lcContenido)
        
        * ?? CONTROL SOBERANO: Analizar si el archivo reporta un ERROR de la SUNAT
        IF nLineas >= 1 AND "ERROR" $ UPPER(aLineas[1])
            
            * ?? SI EL ERROR ES PORQUE NO HAY COMPROBANTES (CÓDIGO 1070), SE INYECTAN ZEROS CON ÉXITO
            IF "1070" $ lcContenido OR "NO SE HA ENCONTRADO INFORMACI" $ UPPER(lcContenido)
                lcSQL = "UPDATE proceso_resumen_sire_compras SET " + ;
                        "estado_barrido = 'PROCESADO', updated_at = NOW(), total_documentos = 0, " + ;
