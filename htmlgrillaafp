<script>
$(document).ready(function() {
    $("#formEnviarCorreo").validate({
        rules:{
            'correo': {
                required: true,
                email : true,
            },
        },
        messages: {
            'correo': {
                required : "Ingrese un correo electrónico.",
                email : "El correo electrónico ingresado no es válido.",
            },
        },
        submitHandler: function(form) {
           $.blockUI({message : "Enviando correo electrónico. Por favor espere.....", fadeIn: 0, baseZ: 2000});
           var data =$("#formConstancia").serialize();
           var correo=$("#correo").val();
           $.ajax({
               url: 'solicituddevolucion/enviarConstancia?correoElectronico=' + correo,
               dataType:'JSON',
               type: 'POST',
               data: data,
               cache: false,
           }).done(function( respuesta ) {
               var text1 = "Se ha enviado la constancia de devolución al correo ";
               var mensaje = text1.concat(correo);
               AlertDialog.showSuccess(mensaje);
           }).error(function(xhr, status, text){ 
              AlertDialog.showAJAXError(xhr, status, text);
           }).complete(function(jqXHR, textStatus){
                $.unblockUI(); // Fin de bloqueo
           });
            return false;
        }
    });
    $( "#btnImprimir" ).click(function() {
      window.print();
    });
    
});


                 
                  

</script>



