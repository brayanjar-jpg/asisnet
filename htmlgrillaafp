lcPeriodoFiltro = RIGHT(lcPeriodoRaw, 4) + LEFT(lcPeriodoRaw, 2)

* 2. Cadena de conexión de emergencia por si se perdió el canal
lcConnectionString = "Driver={PostgreSQL ANSI(x86)};" + ;
                     "Server=aws-0-sa-east-1.pooler.supabase.com;" + ;
                     "Port=5432;" + ;
                     "Database=postgres;" + ;
                     "UID=postgres.atryivflkhjsynrqzora;" + ;
                     "PWD=Angelo2862*12;" + ;
                     "SSLmode=require;" + ;
                     "ConnSettings=SET client_encoding TO 'UTF8';"

* 3. Intentar levantar una conexión limpia exclusiva para esta pestaña
lnHandle = SQLSTRINGCONNECT(lcConnectionString)

IF lnHandle > 0

    * 4. Cadena SQL corregida con los alias 'v' y 'c' indispensables para el SIRE
    lcSQL = "SELECT e.ruc, e.nombre, " + ;
            "CAST(RIGHT(e.ruc, 1) AS varchar(1)) as ultimo_digito, " + ;
            "COALESCE(v.estado_barrido, 'PENDIENTE') AS estado_barrido, " + ;
            "COALESCE(v.total_documentos, 0) AS total_documentos, " + ;
            "COALESCE(v.base_imponible_gravada, 0) AS base_imponible_gravada, " + ;
            "COALESCE(v.monto_igv_ipm, 0) AS monto_igv_ipm, " + ;
            "COALESCE(v.descuento_base_imponible, 0) AS descuento_base_imponible, " + ;
            "COALESCE(v.descuento_igv_ipm, 0) AS descuento_igv_ipm, " + ;
            "COALESCE(v.importe_total_cp, 0) AS importe_total_cp " + ;
            "FROM empresas e " + ;
            "INNER JOIN plantilla_resumen_sire p ON e.id = p.empresa_id " + ;
            "LEFT JOIN proceso_resumen_sire_ventas v ON e.id = v.empresa_id AND v.periodo_animes = ?lcPeriodoFiltro " + ;
            "WHERE e.activo = true AND p.activo = true " + ;
            "ORDER BY ultimo_digito ASC, e.ruc ASC;"

    lnResult = SQLEXEC(lnHandle, lcSQL, "curResumenVentas")

    IF lnResult > 0
        * --- FIX MEMO -> CHARACTER ---
        SELECT ;
            ruc, ;
            PADR(nombre, 150)         AS nombre, ;
            total_documentos, ;
            PADR(estado_barrido, 20)  AS estado_barrido, ;
            base_imponible_gravada, ;
            monto_igv_ipm, ;
            descuento_base_imponible, ; 
            descuento_igv_ipm, ;        
            importe_total_cp ;          
            FROM curResumenVentas ;
            INTO CURSOR curResumenVentasFix READWRITE

        WITH ThisForm.pageframe1.page2.Grid2
            .RecordSource = ""
            .RecordSourceType = 1
            .RecordSource = "curResumenVentasFix"
            .Refresh()
        ENDWITH
    ELSE
        =AERROR(laError)
        MESSAGEBOX("Error al ejecutar SQL de Ventas: " + laError(2), 16, "Error")
    ENDIF

    * Desconexión limpia local de Supabase al terminar la pestaña
    =SQLDISCONNECT(lnHandle)

ELSE
    MESSAGEBOX("No se pudo conectar a Supabase para cargar el Resumen de Ventas.", 16, "Error")
ENDIF


