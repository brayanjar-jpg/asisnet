				        AlertDialog.showInfo('Sr. Contribuyente, los montos que se muestran no consideran el resultado de las acciones de fiscalización, reclamación, apelación o en demanda contencioso-administrativa que se encuentren en proceso. Tome estos montos como referenciales.');
	      				return;
	      			} else if(montoNumerico < 0) {
	      				$('#solicitudDevolucion\\.mtoSolicitado').val("");
	      				AlertDialog.showInfo('Sr. Contribuyente, si usted ha sido sujeto a una acción de fiscalización en los últimos 4 años, no podrá visualizar el saldo propuesto.');
