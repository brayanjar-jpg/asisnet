LOCAL lcConnectionString, lnHandle, lcSQL, lnResult
LOCAL laError[1]

* 1. Configuración de fechas para el periodo inicial (Mes Anterior)
LOCAL lnMesActual, lnAnioActual, lnMesProcesar, lnAnioProcesar
LOCAL lcMes, lcAno, lcPeriodoFiltro

lnMesActual  = MONTH(DATE())
lnAnioActual = YEAR(DATE())

IF lnMesActual = 1
    lnMesProcesar  = 12
    lnAnioProcesar = lnAnioActual - 1
ELSE
    lnMesProcesar  = lnMesActual - 1
    lnAnioProcesar = lnAnioActual
ENDIF

lcMes = PADL(ALLTRIM(STR(lnMesProcesar)), 2, "0")
lcAno = ALLTRIM(STR(lnAnioProcesar))

* Variable limpia que pasaremos directamente como parámetro a PostgreSQL (Ej: "202608")
lcPeriodoFiltro = lcAno + lcMes

* 2. Cadena de conexión directa con tu base de datos de Supabase
lcConnectionString = "Driver={PostgreSQL ANSI(x86)};" + ;
                     "Server=aws-0-sa-east-1.pooler.supabase.com;" + ;
                     "Port=5432;" + ;
                     "Database=postgres;" + ;
                     "UID=postgres.atryivflkhjsynrqzora;" + ;
                     "PWD=Angelo2862*12;" + ;
                     "SSLmode=require;" + ;
                     "ConnSettings=SET client_encoding TO 'UTF8';"

=SQLSETPROP(0, "ConnectTimeOut", 15)
=SQLSETPROP(0, "DispLogin", 3)

* Intentar abrir conexión con el servidor en la nube
lnHandle = SQLSTRINGCONNECT(lcConnectionString)

IF lnHandle > 0
    
    * =========================================================================
    * CONSULTA PARAMETRIZADA: Se agregó e.link_whatsapp al final del bloque de la empresa
    * =========================================================================
lcSQL = "SELECT " + ;
            "e.id, e.ruc, " + ;
            "CAST(RIGHT(e.ruc, 1) AS varchar(1)) as ultimo_digito, " + ;
            "CAST(e.nombre AS varchar(150)) as nombre, " + ;
            "CAST(COALESCE(v.estado_barrido, 'PENDIENTE') AS varchar(20)) as estado_barrido, " + ;
            "CAST(COALESCE(e.usuario_sol, '') AS varchar(50)) as usuario_sol, " + ;
            "CAST(COALESCE(e.clave_sol, '') AS varchar(50)) as clave_sol, " + ;
            "CAST(COALESCE(e.client_id, '') AS varchar(150)) as client_id, " + ;
            "CAST(COALESCE(e.client_secret, '') AS varchar(150)) as client_secret, " + ;
            "CAST(COALESCE(e.link_whatsapp, '') AS varchar(250)) as link_whatsapp, " + ; && <- Agregado aquí de manera segura
            "CAST(COALESCE(c.bi_gravado_dg, 0) - (COALESCE(v.base_imponible_gravada, 0) + COALESCE(v.descuento_base_imponible, 0)) AS numeric(14,2)) as obs_base_imp, " + ;
            "CAST(COALESCE(c.igv_ipm_dg, 0) - (COALESCE(v.monto_igv_ipm, 0) + COALESCE(v.descuento_igv_ipm, 0)) AS numeric(14,2)) as obs_igv, " + ;
            "CAST(COALESCE(c.total_cp, 0) - COALESCE(v.importe_total_cp, 0) AS numeric(14,2)) as obs_total " + ;
            "FROM empresas e " + ;
            "INNER JOIN plantilla_resumen_sire p ON e.id = p.empresa_id " + ;
            "LEFT JOIN proceso_resumen_sire_ventas v ON e.id = v.empresa_id AND v.periodo_animes = ?lcPeriodoFiltro " + ;
            "LEFT JOIN proceso_resumen_sire_compras c ON e.id = c.empresa_id AND c.periodo_animes = ?lcPeriodoFiltro " + ;
            "WHERE e.activo = true AND p.activo = true " + ;
            "ORDER BY ultimo_digito asc, e.ruc asc;"

            
    lnResult = SQLEXEC(lnHandle, lcSQL, "curSireMensual")
    
    IF lnResult > 0
        SELECT curSireMensual
        
        * Sincronización segura del RecordSource del Grid
        ThisForm.pageframe1.page1.Grid1.RecordSource = ""
        ThisForm.pageframe1.page1.Grid1.RecordSourceType = 1 && Alias
        ThisForm.pageframe1.page1.Grid1.RecordSource     = "curSireMensual"
        
        * Asegurar el enfoque limpio en la pestaña 1
        ThisForm.pageframe1.ActivePage = 1
        
        WITH ThisForm.pageframe1.page1.Grid1
            .RecordSource = ""  && Desenlazar antes de dimensionar
            .ColumnCount = 13   && Ampliado de 12 a 13 columnas para meter el link de whatsapp
            
            * Ocultamos de los ojos del asistente las credenciales de la grilla
            .Columns(1).Visible = .F.  && ID Interno
            .Columns(3).Visible = .F.  && Último Dígito de Control
            .Columns(6).Visible = .F.  && Usuario SOL
            .Columns(7).Visible = .F.  && Clave SOL
            .Columns(8).Visible = .F.  && Client ID API
            .Columns(9).Visible = .F.  && Client Secret API
            .Columns(10).Visible = .F. && Link de WhatsApp Oculto e Invisible en el Grid
            
            * Forzamos visibilidad de las columnas base originales
            .Columns(2).Visible = .T.  
            .Columns(4).Visible = .T.  
            .Columns(5).Visible = .T.  && Estado Bot
            
            * Nuevas columnas de Observaciones Visibles (Cambiaron de índice de posición)
            .Columns(11).Visible = .T.  && Obs Base Imp
            .Columns(12).Visible = .T.  && Obs Igv
            .Columns(13).Visible = .T.  && Obs Total
            
            * Rotulamos todas las columnas visibles
            .Columns(2).Header1.Caption = "Número de RUC"
            .Columns(4).Header1.Caption = "Razón Social o Nombre del Cliente"
            .Columns(5).Header1.Caption = "Estado Bot"
            .Columns(11).Header1.Caption = "Obs Base Imp"
            .Columns(12).Header1.Caption = "Obs Igv"
            .Columns(13).Header1.Caption = "Obs Total"
            
            * Enlazar los nuevos orígenes de datos calculados
            .Columns(11).ControlSource = "curSireMensual.obs_base_imp"
            .Columns(12).ControlSource = "curSireMensual.obs_igv"
            .Columns(13).ControlSource = "curSireMensual.obs_total"
            
            * Máscaras numéricas de formato estándar peruano
            .Columns(11).InputMask = "999,999,999.99"
            .Columns(12).InputMask = "999,999,999.99"
            .Columns(13).InputMask = "999,999,999.99"
            
            * Dimensionamos anchos proporcionales estéticos
            .Columns(2).Width  = 100
            .Columns(4).Width  = 330    
            .Columns(5).Width  = 100    
            .Columns(11).Width = 110    
            .Columns(12).Width = 100    
            .Columns(13).Width = 100
            
            * Aplicación de colores dinámicos a la nueva posición de la columna de totales (Column13)
            .Column13.DynamicBackColor = "IIF(obs_total < 0, RGB(255, 0, 0), RGB(255, 255, 255))"
            .Column13.DynamicForeColor = "IIF(obs_total < 0, RGB(255, 255, 255), RGB(0, 0, 0))"
            
            * Ajustes generales de comportamiento de la grilla
            .HeaderHeight = 25
            .RowHeight    = 22
            .AllowCellSelection = .F. && Fila completa para activar DblClick directamente en el Grid
            
            * Reconectar el cursor de forma segura al final
            .RecordSource = "curSireMensual"
            .Refresh()
        ENDWITH

    ELSE
        =AERROR(laError)
        MESSAGEBOX("Error al cargar la lista base del SIRE: " + laError(2), 16, "Error")
    ENDIF
    
    * Desconexión limpia del canal de red
    =SQLDISCONNECT(lnHandle)
ELSE
    =AERROR(laError)
    MESSAGEBOX("Falló el enlace con Supabase: " + laError(2), 16, "Error de Red")
ENDIF

