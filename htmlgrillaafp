LOCAL lcConnectionString, lnHandle, lcSQL1, lcSQL2, lnResult1, lnResult2
LOCAL lnTotalEmpresas, lnTotalTrabajadores, lnTotalAFP
LOCAL ARRAY laError[1]

* =========================================================================
* 1. CADENA DE CONEXIÓN ÚNICA Y CONFIGURACIÓN DE ENTORNO
* =========================================================================
lcConnectionString = "Driver={PostgreSQL ANSI(x86)};" + ;
                     "Server=aws-0-sa-east-1.pooler.supabase.com;" + ;
                     "Port=5432;" + ;
                     "Database=postgres;" + ;
                     "UID=postgres.atryivflkhjsynrqzora;" + ;
                     "PWD=Angelo2862*12;" + ;
                     "SSLmode=require;" + ;
                     "ConnSettings=SET client_encoding TO 'UTF8';"

=SQLSETPROP(0, "ConnectTimeOut", 15)
=SQLSETPROP(0, "DispLogin", 3)

lnHandle = SQLSTRINGCONNECT(lcConnectionString)

IF lnHandle > 0
    * ---------------------------------------------------------------------
    * CONSULTA DE EMPRESAS -> GRID 1 (PAGE 1)
    * ---------------------------------------------------------------------
    lcSQL1 = "SELECT * FROM v_empresas_pdt0601 ORDER BY ultimo_digito ASC, ruc ASC;"
    lnResult1 = SQLEXEC(lnHandle, lcSQL1, "curEmpresasPdt")
    
    IF lnResult1 > 0
        SELECT curEmpresasPdt
        COUNT TO lnTotalEmpresas
        ThisForm.pageframe1.page1.text1.Value = lnTotalEmpresas
        GO TOP
        
        ThisForm.pageframe1.page1.Grid1.RecordSource = ""
        ThisForm.pageframe1.page1.Grid1.RecordSourceType = 1
        ThisForm.pageframe1.page1.Grid1.RecordSource     = "curEmpresasPdt"
        
        WITH ThisForm.pageframe1.page1.Grid1
            .ColumnCount = 7  
            .Columns(1).ControlSource = "curEmpresasPdt.ruc"
            .Columns(2).ControlSource = "curEmpresasPdt.nombre"
            .Columns(3).ControlSource = "curEmpresasPdt.usuario_sol"
            .Columns(4).ControlSource = "curEmpresasPdt.clave_sol"
            .Columns(5).ControlSource = "curEmpresasPdt.obligado_desde"
            .Columns(6).ControlSource = "curEmpresasPdt.total_trabajadores"
            
            .Columns(1).Header1.Caption = "RUC"
            .Columns(2).Header1.Caption = "Razón Social / Nombre"
            .Columns(3).Header1.Caption = "Usuario SOL"
            .Columns(4).Header1.Caption = "Clave SOL"
            .Columns(5).Header1.Caption = "Obligado Desde"
            .Columns(6).Header1.Caption = "Trab. Activos"
            .Columns(7).Header1.Caption = "Afecto"  
            
            .Columns(1).Width = 95
            .Columns(2).Width = 230
            .Columns(3).Width = 85
            .Columns(4).Width = 85
            .Columns(5).Width = 90
            .Columns(6).Width = 80
            .Columns(7).Width = 50  
            .Columns(6).Alignment = 2 
            .HeaderHeight = 25        
            .RowHeight    = 22        
            .HighlightStyle = 2
            .Refresh()
        ENDWITH
    ELSE
        AERROR(laError)
        MESSAGEBOX("Error al consultar Grid1: " + laError(2), 16, "Error")
    ENDIF
    * ---------------------------------------------------------------------
    * CONSULTA DE TRABAJADORES -> GRID 2 (PAGE 2) y GRID 1 (PAGE 3)
    * ---------------------------------------------------------------------
    lcSQL2 = "SELECT " + ;
             "CAST(ruc_empresa AS varchar(11)) as ruc_empresa, " + ;
             "CAST(dni AS varchar(15)) as dni, " + ;
             "CAST(nombres_completos AS varchar(150)) as nombres_completos, " + ;
             "CAST(fecha_nacimiento AS varchar(20)) as fecha_nacimiento, " + ;
             "CAST(sexo AS varchar(20)) as sexo, " + ;
             "CAST(estado_sunat AS varchar(50)) as estado_sunat, " + ;
             "CAST(fecha_inicio_labores AS varchar(20)) as fecha_inicio_labores, " + ;
             "CAST(regimen_pensionario AS varchar(150)) as regimen_pensionario, " + ; 
             "CAST(cuspp AS varchar(50)) as cuspp, " + ;
             "CAST(remuneracion_basica AS numeric(10,2)) as remun_basica " + ; 
             "FROM v_comprobante_tregistro " + ;
             "ORDER BY RIGHT(CAST(ruc_empresa AS varchar(11)), 1) ASC, ruc_empresa ASC, fecha_inicio_labores ASC;"

    lnResult2 = SQLEXEC(lnHandle, lcSQL2, "curDescargaRaw")
    
    IF lnResult2 > 0
        * Romper campos MEMO forzando a variables de longitud de cadena estática (C)
        SELECT CAST(ruc_empresa AS C(11)) as ruc_empresa, ;
               CAST(dni AS C(15)) as dni, ;
               PADR(nombres_completos, 120) as nombres_completos, ; 
               CAST(fecha_nacimiento AS C(20)) as fecha_nacimiento, ;
               CAST(sexo AS C(20)) as sexo, ;
               CAST(estado_sunat AS C(50)) as estado_sunat, ;
               CAST(fecha_inicio_labores AS C(20)) as fecha_inicio_labores, ;
               PADR(regimen_pensionario, 120) as regimen_pensionario, ; 
               CAST(cuspp AS C(50)) as cuspp, ;
               remun_basica ;
          FROM curDescargaRaw ;
          INTO CURSOR curComprobantes READWRITE
          
        USE IN curDescargaRaw 
        
        * ASIGNACIÓN A PAGE 2: TODOS LOS TRABAJADORES
        SELECT curComprobantes
        COUNT TO lnTotalTrabajadores
        ThisForm.pageframe1.page2.text1.Value = lnTotalTrabajadores
        GO TOP
        
        ThisForm.pageframe1.page2.Grid2.RecordSource = ""
        ThisForm.pageframe1.page2.Grid2.RecordSourceType = 1
        ThisForm.pageframe1.page2.Grid2.RecordSource     = "curComprobantes"
        
        WITH ThisForm.pageframe1.page2.Grid2
            .ColumnCount = 7  
            .Columns(1).ControlSource = "curComprobantes.ruc_empresa"
            .Columns(2).ControlSource = "curComprobantes.dni"
            .Columns(3).ControlSource = "curComprobantes.nombres_completos" 
            .Columns(4).ControlSource = "curComprobantes.fecha_nacimiento"
            .Columns(5).ControlSource = "curComprobantes.sexo"
            .Columns(6).ControlSource = "curComprobantes.estado_sunat"
            .Columns(7).ControlSource = "curComprobantes.fecha_inicio_labores"
            
            .Columns(1).Header1.Caption = "RUC"
            .Columns(2).Header1.Caption = "DNI / N° Doc"
            .Columns(3).Header1.Caption = "Nombres Completos"
            .Columns(4).Header1.Caption = "Fecha Nac."
            .Columns(5).Header1.Caption = "Sexo"
            .Columns(6).Header1.Caption = "Estado Sunat"
            .Columns(7).Header1.Caption = "F. Inicio Labores"
            
            .Columns(1).Width = 90
            .Columns(2).Width = 90
            .Columns(3).Width = 230
            .Columns(4).Width = 90
            .Columns(5).Width = 90
            .Columns(6).Width = 100
            .Columns(7).Width = 100
            .HeaderHeight = 25        
            .RowHeight    = 22        
            .HighlightStyle = 2
            .Refresh()
        ENDWITH

        * ASIGNACIÓN A PAGE 3: SOLO TRABAJADORES AFP (9 columnas)
  SELECT * ;
    FROM curComprobantes ;
    WHERE "SPP" $ UPPER(regimen_pensionario) ;
    INTO CURSOR curTrabajadoresAfp READWRITE
            
        SELECT curTrabajadoresAfp
        COUNT TO lnTotalAFP
        ThisForm.pageframe1.page3.text1.Value = lnTotalAFP
        GO TOP
            
        ThisForm.pageframe1.page3.Grid1.RecordSource = ""
        ThisForm.pageframe1.page3.Grid1.RecordSourceType = 1
        ThisForm.pageframe1.page3.Grid1.RecordSource     = "curTrabajadoresAfp"
        
        WITH ThisForm.pageframe1.page3.Grid1
            .ColumnCount = 9  
            .Columns(1).ControlSource = "curTrabajadoresAfp.ruc_empresa"
            .Columns(2).ControlSource = "curTrabajadoresAfp.dni"
            .Columns(3).ControlSource = "curTrabajadoresAfp.nombres_completos" 
            .Columns(4).ControlSource = "curTrabajadoresAfp.estado_sunat"
            .Columns(5).ControlSource = "curTrabajadoresAfp.fecha_inicio_labores"
            .Columns(6).ControlSource = "curTrabajadoresAfp.remun_basica"        
            .Columns(7).ControlSource = "curTrabajadoresAfp.regimen_pensionario" 
            .Columns(8).ControlSource = "curTrabajadoresAfp.cuspp"              
            .Columns(9).ControlSource = "curTrabajadoresAfp.sexo"               
            
            .Columns(1).Header1.Caption = "RUC"
            .Columns(2).Header1.Caption = "DNI / N° Doc"
            .Columns(3).Header1.Caption = "Nombres Completos"
            .Columns(4).Header1.Caption = "Estado"
            .Columns(5).Header1.Caption = "F. Inicio"
            .Columns(6).Header1.Caption = "Básico S/."
            .Columns(7).Header1.Caption = "AFP / Régimen"
            .Columns(8).Header1.Caption = "Código CUSPP"
            .Columns(9).Header1.Caption = "Sexo"
            
            .Columns(1).Width = 90
            .Columns(2).Width = 85
            .Columns(3).Width = 200
            .Columns(4).Width = 85
            .Columns(5).Width = 85
            .Columns(6).Width = 80   
            .Columns(7).Width = 120  
            .Columns(8).Width = 100  
            .Columns(9).Width = 50
            .Columns(6).Alignment = 1 
            .HeaderHeight = 25        
            .RowHeight    = 22        
            .HighlightStyle = 2
            .Refresh()
        ENDWITH
    ELSE
        AERROR(laError)
        MESSAGEBOX("Error al consultar trabajadores: " + laError(2), 16, "Error")
    ENDIF
    
    =SQLDISCONNECT(lnHandle)
ELSE
    AERROR(laError)
    MESSAGEBOX("Falló la conexión unificada a Supabase: " + laError(2), 16, "Error de Conexión")
ENDIF

ThisForm.Refresh()
